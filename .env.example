# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for the AI load assistant (console.anthropic.com). Optional:
# without it the load assistant uses a free built-in estimator instead.
ANTHROPIC_API_KEY=
